:root {
  --ink: #123c34;
  --ink-deep: #0a241f;
  --mist: #e8f2ed;
  --paper: #f6faf7;
  --signal: #d4a24c;
  --signal-deep: #b8842f;
  --line: rgba(18, 60, 52, 0.14);
  --muted: rgba(18, 60, 52, 0.68);
  --white: #ffffff;

  --font-display: "Bricolage Grotesque", Georgia, serif;
  --font-body: "Source Sans 3", "Segoe UI", sans-serif;

  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --max: 1120px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.55;
  color: var(--ink);
  background:
    radial-gradient(1200px 600px at 10% -10%, rgba(212, 162, 76, 0.12), transparent 55%),
    radial-gradient(900px 500px at 100% 0%, rgba(18, 60, 52, 0.08), transparent 50%),
    linear-gradient(180deg, var(--mist) 0%, var(--paper) 40%, var(--white) 100%);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.site {
  overflow-x: clip;
}

.nav {
  position: absolute;
  inset: 0 0 auto;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(100% - 2rem, var(--max));
  margin: 0 auto;
  padding: 1.25rem 0;
  color: var(--white);
}

.nav__mark {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.125rem;
  letter-spacing: -0.02em;
}

.nav__link {
  font-size: 0.95rem;
  font-weight: 500;
  opacity: 0.9;
  border-bottom: 1px solid transparent;
  transition: border-color 200ms var(--ease-out), opacity 200ms var(--ease-out);
}

.nav__link:hover {
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.55);
}

.hero {
  position: relative;
  min-height: 100svh;
  display: grid;
  align-items: end;
  color: var(--white);
}

.hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  transform: scale(1.04);
  animation: hero-drift 18s var(--ease-out) both;
}

.hero__shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 36, 31, 0.35) 0%, rgba(10, 36, 31, 0.2) 35%, rgba(10, 36, 31, 0.78) 100%),
    linear-gradient(90deg, rgba(10, 36, 31, 0.55) 0%, rgba(10, 36, 31, 0.15) 55%, rgba(10, 36, 31, 0.35) 100%);
}

.hero__content {
  position: relative;
  z-index: 1;
  width: min(100% - 2rem, var(--max));
  margin: 0 auto;
  padding: 0 0 4.5rem;
  animation: rise 900ms var(--ease-out) both;
}

.brand {
  margin: 0 0 1rem;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(3.4rem, 10vw, 6.5rem);
  line-height: 0.92;
  letter-spacing: -0.045em;
}

.hero__headline {
  margin: 0 0 0.85rem;
  max-width: 16ch;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.55rem, 3.4vw, 2.35rem);
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.hero__lede {
  margin: 0 0 1.75rem;
  max-width: 34ch;
  font-size: 1.125rem;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1rem;
  align-items: center;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.85rem;
  padding: 0.7rem 1.25rem;
  border-radius: 0.35rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  transition:
    transform 180ms var(--ease-out),
    background-color 180ms var(--ease-out),
    color 180ms var(--ease-out),
    border-color 180ms var(--ease-out);
}

.btn:hover {
  transform: translateY(-1px);
}

.btn--primary {
  background: var(--signal);
  color: var(--ink-deep);
  border: 1px solid var(--signal);
}

.btn--primary:hover {
  background: #e0b15d;
  border-color: #e0b15d;
}

.btn--ghost {
  background: transparent;
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.45);
}

.btn--ghost:hover {
  border-color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.06);
}

.btn--ink {
  background: var(--ink);
  color: var(--white);
  border: 1px solid var(--ink);
}

.btn--ink:hover {
  background: var(--ink-deep);
}

.section {
  width: min(100% - 2rem, var(--max));
  margin: 0 auto;
  padding: 5.5rem 0;
}

.section__label {
  margin: 0 0 0.65rem;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--signal-deep);
}

.section__title {
  margin: 0 0 0.85rem;
  max-width: 16ch;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2rem, 4.2vw, 3rem);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.section__copy {
  margin: 0;
  max-width: 48ch;
  color: var(--muted);
  font-size: 1.1rem;
}

.promise {
  display: grid;
  gap: 2rem;
  border-top: 1px solid var(--line);
}

.work {
  background:
    linear-gradient(180deg, transparent, rgba(18, 60, 52, 0.03) 18%, rgba(18, 60, 52, 0.03) 82%, transparent);
}

.product-list {
  list-style: none;
  margin: 2.75rem 0 0;
  padding: 0;
  display: grid;
  gap: 0;
}

.product-list li {
  border-top: 1px solid var(--line);
}

.product-list li:last-child {
  border-bottom: 1px solid var(--line);
}

.product-link {
  display: grid;
  gap: 0.65rem;
  padding: 1.35rem 0;
  transition: color 180ms var(--ease-out);
}

.product-link__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.35rem 1rem;
}

.product-link__name {
  font-family: var(--font-display);
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.product-link__bottleneck {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--signal-deep);
}

.product-link__summary {
  margin: 0;
  max-width: 62ch;
  color: var(--muted);
}

.product-link__cta {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.product-link__cta::after {
  content: " →";
}

.product-link:hover .product-link__name,
.product-link:hover .product-link__cta {
  color: var(--signal-deep);
}

@media (min-width: 768px) {
  .product-link {
    grid-template-columns: 1.1fr 1.6fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 1.6rem 0;
  }

  .product-link__meta {
    display: grid;
    gap: 0.35rem;
  }

  .product-link__cta {
    align-self: center;
    white-space: nowrap;
  }
}

.promise__visual {
  position: relative;
  margin-top: 1.25rem;
  min-height: 12rem;
  border-radius: 0.2rem;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(18, 60, 52, 0.08), transparent 40%),
    repeating-linear-gradient(
      -18deg,
      transparent,
      transparent 14px,
      rgba(18, 60, 52, 0.05) 14px,
      rgba(18, 60, 52, 0.05) 15px
    ),
    var(--mist);
}

.promise__track {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 50%;
  height: 2px;
  background: rgba(18, 60, 52, 0.18);
  transform: translateY(-50%);
}

.promise__pulse {
  position: absolute;
  top: 50%;
  left: 8%;
  width: 0.85rem;
  height: 0.85rem;
  border-radius: 50%;
  background: var(--signal);
  transform: translate(-50%, -50%);
  animation: pulse-move 4.5s var(--ease-out) infinite;
  box-shadow: 0 0 0 0 rgba(212, 162, 76, 0.45);
}

.promise__nodes {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8%;
}

.promise__nodes span {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--ink);
  opacity: 0.35;
}

.method {
  background:
    linear-gradient(180deg, transparent, rgba(18, 60, 52, 0.035) 20%, rgba(18, 60, 52, 0.035) 80%, transparent);
}

.method__grid {
  display: grid;
  gap: 2.5rem;
  margin-top: 2.75rem;
  counter-reset: step;
}

.method__item {
  position: relative;
  padding-top: 0.25rem;
  border-top: 1px solid var(--line);
  animation: fade-up 700ms var(--ease-out) both;
}

.method__item:nth-child(2) {
  animation-delay: 120ms;
}

.method__item:nth-child(3) {
  animation-delay: 220ms;
}

.method__item h3 {
  margin: 1.1rem 0 0.55rem;
  font-family: var(--font-display);
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.method__item p {
  margin: 0;
  max-width: 36ch;
  color: var(--muted);
}

.method__item::before {
  counter-increment: step;
  content: "0" counter(step);
  display: block;
  margin-top: 1rem;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  color: var(--signal-deep);
}

.audience {
  display: grid;
  gap: 1.5rem;
}

.audience__list {
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0;
}

.audience__list li {
  display: grid;
  grid-template-columns: 1.4rem 1fr;
  gap: 0.85rem;
  align-items: start;
  padding: 1.1rem 0;
  border-top: 1px solid var(--line);
  color: var(--ink);
  font-size: 1.1rem;
  font-weight: 500;
}

.audience__list li:last-child {
  border-bottom: 1px solid var(--line);
}

.audience__list li::before {
  content: "";
  width: 0.55rem;
  height: 0.55rem;
  margin-top: 0.5rem;
  border-radius: 50%;
  background: var(--signal);
}

.closing {
  padding-bottom: 6rem;
}

.closing__panel {
  display: grid;
  gap: 1.5rem;
  padding: 2.5rem 0 0;
  border-top: 1px solid var(--line);
}

.closing__panel .section__title {
  max-width: 14ch;
}

.footer {
  width: min(100% - 2rem, var(--max));
  margin: 0 auto;
  padding: 1.5rem 0 2.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.95rem;
}

.footer strong {
  color: var(--ink);
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.02em;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes hero-drift {
  from {
    transform: scale(1.08);
  }
  to {
    transform: scale(1.04);
  }
}

@keyframes pulse-move {
  0% {
    left: 8%;
    box-shadow: 0 0 0 0 rgba(212, 162, 76, 0.45);
  }
  70% {
    box-shadow: 0 0 0 12px rgba(212, 162, 76, 0);
  }
  100% {
    left: 92%;
    box-shadow: 0 0 0 0 rgba(212, 162, 76, 0);
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 768px) {
  .promise {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: end;
    gap: 3rem;
  }

  .method__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .audience {
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 3rem;
  }

  .closing__panel {
    grid-template-columns: 1.3fr auto;
    align-items: end;
    gap: 2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .hero__media img,
  .hero__content,
  .method__item,
  .promise__pulse {
    animation: none !important;
  }
}
